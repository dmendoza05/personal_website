# Neon Postgres connection string (pooled recommended for serverless)
DATABASE_URL=

# Cloudflare Analytics API (ingest Worker only — never expose to the browser)
# Site dashboard reads Neon via /api/dashboard; only the ingest cron calls Cloudflare.
# Production (ingest Worker): wrangler secret put --config workers/analytics-ingest/wrangler.jsonc DATABASE_URL
#   wrangler secret put --config workers/analytics-ingest/wrangler.jsonc CF_ANALYTICS_TOKEN
#   wrangler secret put --config workers/analytics-ingest/wrangler.jsonc CF_ZONE_ID
# Local ingest: copy workers/analytics-ingest/.dev.vars.example to workers/analytics-ingest/.dev.vars
CF_ANALYTICS_TOKEN=
CF_ZONE_ID=
