{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "personal-website-analytics-ingest",
	"main": "index.ts",
	"compatibility_date": "2026-08-04",
	"compatibility_flags": ["nodejs_compat"],
	"triggers": {
		"crons": ["0 6 * * *"]
	},
	"vars": {
		"ENVIRONMENT": "production"
	},
	"observability": {
		"enabled": true
	}
}
